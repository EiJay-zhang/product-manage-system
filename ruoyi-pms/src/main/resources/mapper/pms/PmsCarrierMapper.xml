<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.pms.mapper.PmsCarrierMapper">
    <resultMap id="PmsCarrierResult" type="PmsCarrier">
        <id property="carrierId" column="carrier_id"/>
        <result property="carrierName" column="carrier_name"/>
        <result property="contactName" column="contact_name"/>
        <result property="phone" column="phone"/>
        <result property="status" column="status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <sql id="selectVo">
        select carrier_id, carrier_name, contact_name, phone, status, del_flag, create_by, create_time, update_by, update_time, remark
        from pms_carrier
    </sql>
    <select id="selectCarrierList" parameterType="PmsCarrier" resultMap="PmsCarrierResult">
        <include refid="selectVo"/>
        <where>
            del_flag = '0'
            <if test="carrierName != null and carrierName != ''">AND carrier_name like concat('%', #{carrierName}, '%')</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        order by carrier_id desc
    </select>
    <select id="selectCarrierById" resultMap="PmsCarrierResult">
        <include refid="selectVo"/> where carrier_id = #{carrierId}
    </select>
    <select id="checkCarrierNameUnique" resultMap="PmsCarrierResult">
        <include refid="selectVo"/> where carrier_name = #{carrierName} and del_flag = '0' limit 1
    </select>
    <select id="countLogisticsByCarrierId" resultType="int">
        select count(1) from pms_logistics where carrier_id = #{carrierId}
    </select>
    <insert id="insertCarrier" parameterType="PmsCarrier" useGeneratedKeys="true" keyProperty="carrierId">
        insert into pms_carrier (carrier_name, contact_name, phone, status, del_flag, create_by, create_time, remark)
        values (#{carrierName}, #{contactName}, #{phone}, #{status}, '0', #{createBy}, sysdate(), #{remark})
    </insert>
    <update id="updateCarrier" parameterType="PmsCarrier">
        update pms_carrier
        <set>
            <if test="carrierName != null">carrier_name = #{carrierName},</if>
            <if test="contactName != null">contact_name = #{contactName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_by = #{updateBy}, update_time = sysdate()
        </set>
        where carrier_id = #{carrierId}
    </update>
    <update id="deleteCarrierByIds">
        update pms_carrier set del_flag = '2' where carrier_id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>
